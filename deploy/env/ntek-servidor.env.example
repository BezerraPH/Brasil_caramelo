# =============================================================================
# BRASIL CARAMELO — ntek-servidor (Tailscale Serve)
# =============================================================================
#
# No servidor:
#   cp deploy/env/ntek-servidor.env.example .env
#   nano .env    # PEDIGREE_PIX_KEY + PREMIUM_ADMIN_USERNAMES + rode VAPID abaixo
#   bash scripts/generate-vapid-keys.sh   # copie as 3 linhas VAPID para .env
#   docker compose up -d --build
#   bash scripts/setup-minio-bucket.sh
#   bash scripts/reindex-meilisearch.sh
#   bash scripts/check-production-env.sh
#
# URL: https://ntek-servidor.tail51633c.ts.net
# =============================================================================

# --- Rede (LAN + Tailscale) --------------------------------------------------

# Hostname Tailscale (setup-tailscale.sh grava aqui; smoke/audit)
BC_HOST=ntek-servidor.tail51633c.ts.net
BC_LAN_IP=192.168.1.4
BC_TAILSCALE_IP=100.94.55.27

# --- App (obrigatório) -------------------------------------------------------

DATABASE_URL=postgresql://caramelo:caramelo_secret@db:5432/brasil_caramelo
COOKIE_SECURE=true
APP_URL=https://ntek-servidor.tail51633c.ts.net
NEXT_PUBLIC_APP_URL=https://ntek-servidor.tail51633c.ts.net
UPLOAD_DIR=/app/data/uploads

# --- Redis (container — hostname Docker) -------------------------------------

REDIS_URL=redis://redis:6379

# --- Meilisearch (busca — container) -------------------------------------------

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=caramelo_meili_dev_key_change_in_prod

# --- MinIO / S3 (mídia — container; console só no servidor: 127.0.0.1:9001) --

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=caramelo_minio
S3_SECRET_KEY=caramelo_minio_secret_change_me
S3_BUCKET=bc-media
S3_REGION=us-east-1

# --- Soketi — tempo real (nginx :8780 → tailscale :443) ----------------------

PUSHER_APP_ID=brasil-caramelo
PUSHER_KEY=caramelo_key_local
PUSHER_SECRET=caramelo_secret_local
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_USE_TLS=false
NEXT_PUBLIC_PUSHER_KEY=caramelo_key_local
NEXT_PUBLIC_PUSHER_HOST=ntek-servidor.tail51633c.ts.net
NEXT_PUBLIC_PUSHER_PORT=443
NEXT_PUBLIC_PUSHER_USE_TLS=true
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- coturn — WebRTC (IP Tailscale na tailnet) --------------------------------

TURN_USERNAME=caramelo
TURN_PASSWORD=caramelo_turn_secret_change_me
NEXT_PUBLIC_STUN_URL=stun:100.94.55.27:3478
NEXT_PUBLIC_TURN_URL=turn:100.94.55.27:3478
NEXT_PUBLIC_TURN_USERNAME=caramelo
NEXT_PUBLIC_TURN_CREDENTIAL=caramelo_turn_secret_change_me

# --- LiveKit — Latidos (wss via nginx / tailscale serve) ----------------------

LIVEKIT_API_KEY=caramelo_livekit_key
LIVEKIT_API_SECRET=caramelo_livekit_secret_change_me
NEXT_PUBLIC_LIVEKIT_URL=wss://ntek-servidor.tail51633c.ts.net

# --- Push PWA — OBRIGATÓRIO: rode ./scripts/generate-vapid-keys.sh e cole aqui -

NEXT_PUBLIC_VAPID_PUBLIC_KEY=SUBSTITUA_APOS_generate-vapid-keys.sh
VAPID_PRIVATE_KEY=SUBSTITUA_APOS_generate-vapid-keys.sh
VAPID_SUBJECT=mailto:admin@brasilcaramelo.local

# --- Pedigree (PIX / webhook / admin) ----------------------------------------

PEDIGREE_PIX_KEY=SUBSTITUA_SUA_CHAVE_PIX
PEDIGREE_PRICE_BRL=19.90
PREMIUM_WEBHOOK_SECRET=8f3c2a9e1b4d6f0a7c8e2d5b9a1f4e6c3d8b0a2f5e7d9c1b4a6e8f0d2c5b7a9e1
PREMIUM_ADMIN_USERNAMES=SEU_USERNAME,smoke_test
# MERCADOPAGO_ACCESS_TOKEN=   # opcional — checkout MP

# --- Extras ------------------------------------------------------------------

PREMIUM_CODE=MATILHA2026
NEXT_PUBLIC_PET_SHOP_REGION=Recife
EVENT_ADMIN_SECRET=segredo_rolezinho_local
FFMPEG_PATH=/usr/bin/ffmpeg
FEDERATION_EXPORT_SECRET=4e7a1c9f2b8d0e6a3f5c1b7d9e2a4f8c0b6d3e7a1f9c5b2d8e4a0f6c3b9d1e7a5
CRON_SECRET=4925fe64025241db9719408ee7029d0701440c1f40b8ca77

