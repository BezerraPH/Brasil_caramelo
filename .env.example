PREMIUM_WEBHOOK_SECRET=

# Jobs / federação
CRON_SECRET=
FEDERATION_EXPORT_SECRET=

# Vídeo HLS (opcional)
FFMPEG_PATH=

# WebRTC TURN (opcional — melhora chamadas fora da mesma rede)
