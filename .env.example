DATABASE_URL="postgresql://caramelo:caramelo_secret@localhost:5432/brasil_caramelo"
COOKIE_SECURE=false

# URL pública do app (links, notificações). Na LAN com DNS local:
# APP_URL=http://brasilcaramelo.com:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mídia local no servidor (sem Uploadthing). Pasta criada automaticamente.
UPLOAD_DIR="./data/uploads"

# Pusher — opcional (sem isso, notificações usam polling)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=

EVENT_ADMIN_SECRET=
OPENAI_API_KEY=
PREMIUM_CODE=

# WebRTC TURN (opcional — melhora chamadas fora da mesma rede)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
