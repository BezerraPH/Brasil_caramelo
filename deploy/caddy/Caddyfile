# Brasil Caramelo — Caddyfile (Proxy Reverso HTTPS Local & Domínio)
{
    admin off
}

http://brasilcaramelo.com, http://brasilcaramelo.com.br, http://brasilcaramelo.local, http://192.168.1.6, http://100.94.55.27, http://localhost, http://127.0.0.1 {
    redir https://{host}{uri} permanent
}

https://brasilcaramelo.com, https://brasilcaramelo.com.br, https://brasilcaramelo.local, https://192.168.1.6, https://100.94.55.27, https://localhost, https://127.0.0.1 {
    tls internal

    # Soketi / Pusher endpoints
    handle /app/* {
        reverse_proxy soketi:6001
    }

    handle /apps/* {
        reverse_proxy soketi:6001
    }

    # LiveKit WebRTC
    handle /rtc/* {
        reverse_proxy livekit:7880
    }

    # Next.js App (suporta WebSockets e HTTP nativamente)
    handle {
        reverse_proxy app:3000
    }
}
