generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ViewMode {
  FEED
  INSTA
  REELS
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum DogReputationLevel {
  PITBULL
  HUSKY
  CARAMELO
  POODLE
  PINSCHER
  GOLDEN
  VIRALATA
  BORDER_COLLIE
  BASSET_HOUND
  CHOW_CHOW
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

enum PetBattleStatus {
  ACTIVE
  ENDED
}

enum NotificationType {
  REPUTATION_VOTE
  PET_TREAT
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FLASH_EVENT
  PET_BATTLE
  STORY_NEW
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  username     String    @unique
  bio          String?
  avatarUrl    String?
  viewMode     ViewMode  @default(FEED)
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts               Post[]
  comments            Comment[]
  likes               Like[]
  sessions            Session[]
  reputationsGiven    Reputation[]    @relation("ReputationFrom")
  reputationsReceived Reputation[]    @relation("ReputationTo")
  sentFriendships     Friendship[]    @relation("FriendshipRequester")
  receivedFriendships Friendship[]    @relation("FriendshipAddressee")
  pet                 Pet?
  notifications       Notification[]
  treatsGiven         PetTreat[]      @relation("TreatFrom")
  treatsReceived      PetTreat[]      @relation("TreatTo")
  stories             Story[]
  battlesChallenged   PetBattle[]     @relation("BattleChallenger")
  battlesOpposed      PetBattle[]     @relation("BattleOpponent")
  battleVotes         PetBattleVote[]
  storyViews          StoryView[]
  savedPosts          SavedPost[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Post {
  id             String              @id @default(cuid())
  authorId       String
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  imageUrl       String?
  videoUrl       String?
  communityLevel DogReputationLevel?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  comments       Comment[]
  likes          Like[]
  savedBy        SavedPost[]

  @@index([authorId, createdAt])
  @@index([communityLevel, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Reputation {
  id         String             @id @default(cuid())
  fromUserId String
  fromUser   User               @relation("ReputationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User               @relation("ReputationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  level      DogReputationLevel
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([level, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

model Pet {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    @default("Caramelo")
  color             String    @default("#C68642")
  hunger            Int       @default(80)
  happiness         Int       @default(80)
  energy            Int       @default(80)
  level             Int       @default(1)
  experience        Int       @default(0)
  coins             Int       @default(50)
  ownedCosmetics    String[]  @default([])
  equippedHat       String?
  equippedCollar    String?
  equippedAccessory String?
  lastCareAt        DateTime  @default(now())
  lastDailyClaim    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PetTreat {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("TreatFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("TreatTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, toUserId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model Story {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType StoryMediaType @default(IMAGE)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  views     StoryView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model FlashEvent {
  id             String              @id @default(cuid())
  title          String
  message        String
  coinMultiplier Float               @default(2)
  targetLevel    DogReputationLevel?
  startsAt       DateTime            @default(now())
  endsAt         DateTime
  createdAt      DateTime            @default(now())

  @@index([endsAt])
}

model PetBattle {
  id              String          @id @default(cuid())
  challengerId    String
  challenger      User            @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String
  opponent        User            @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status          PetBattleStatus @default(ACTIVE)
  votesChallenger Int             @default(0)
  votesOpponent   Int             @default(0)
  winnerId        String?
  endsAt          DateTime
  createdAt       DateTime        @default(now())
  votes           PetBattleVote[]

  @@index([status, endsAt])
}

model PetBattleVote {
  id        String   @id @default(cuid())
  battleId  String
  battle    PetBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forChallenger Boolean
  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}
