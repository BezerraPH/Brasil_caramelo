# =============================================================================
# BRASIL CARAMELO — configuração self-hosted (copie para .env)
# =============================================================================
#
#   cp .env.example .env
#   nano .env          # ajuste BC_HOST se preciso
#   docker compose up -d --build
#
# Guia completo (deploy, HTTPS, Tailscale, túnel, DNS): CONFIGURACAO.md
# =============================================================================

# IP ou DNS da LAN — usado pelo celular/PC para acessar o servidor
BC_HOST=192.168.1.4

# --- App (obrigatório) -------------------------------------------------------

DATABASE_URL=postgresql://caramelo:caramelo_secret@db:5432/brasil_caramelo
COOKIE_SECURE=false
APP_URL=http://192.168.1.4:3000
NEXT_PUBLIC_APP_URL=http://192.168.1.4:3000
UPLOAD_DIR=/app/data/uploads

# --- MinIO / S3 (mídia — opcional; se preenchido, substitui disco local) ------
# Console MinIO: http://SEU_IP:9001 (localhost no servidor)
# Deixe S3_ENDPOINT vazio para usar só UPLOAD_DIR.

# S3_ENDPOINT=http://192.168.1.4:9000
# S3_ACCESS_KEY=caramelo_minio
# S3_SECRET_KEY=caramelo_minio_secret_change_me
# S3_BUCKET=bc-media
# S3_REGION=us-east-1

# --- Soketi — tempo real (container soketi) ----------------------------------

PUSHER_APP_ID=brasil-caramelo
PUSHER_KEY=caramelo_key_local
PUSHER_SECRET=caramelo_secret_local
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_USE_TLS=false
NEXT_PUBLIC_PUSHER_KEY=caramelo_key_local
NEXT_PUBLIC_PUSHER_HOST=192.168.1.4
NEXT_PUBLIC_PUSHER_PORT=6001
NEXT_PUBLIC_PUSHER_USE_TLS=false
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- coturn — WebRTC (/mensagens) --------------------------------------------

TURN_USERNAME=caramelo
TURN_PASSWORD=caramelo_turn_secret
NEXT_PUBLIC_STUN_URL=stun:192.168.1.4:3478
NEXT_PUBLIC_TURN_URL=turn:192.168.1.4:3478
NEXT_PUBLIC_TURN_USERNAME=caramelo
NEXT_PUBLIC_TURN_CREDENTIAL=caramelo_turn_secret

# --- LiveKit — Latidos ao Vivo (/latidos) ------------------------------------

LIVEKIT_API_KEY=caramelo_livekit_key
LIVEKIT_API_SECRET=caramelo_livekit_secret_change_me
NEXT_PUBLIC_LIVEKIT_URL=ws://192.168.1.4:7880

# --- Redis (cache + rate limit — opcional) -----------------------------------

REDIS_URL=redis://192.168.1.4:6379

# --- Meilisearch (busca rápida — opcional, SQL é fallback) --------------------

MEILISEARCH_HOST=http://192.168.1.4:7700
MEILISEARCH_MASTER_KEY=caramelo_meili_dev_key

# --- Push PWA (tailnet / HTTPS) — gere com: ./scripts/generate-vapid-keys.sh --

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@brasilcaramelo.local

# --- Pedigree (PIX / Mercado Pago) -------------------------------------------

# Chave PIX e valor exibidos no checkout (R$)
PEDIGREE_PIX_KEY=
PEDIGREE_PRICE_BRL=19.90
# Secret para POST /api/premium/webhook (header X-Webhook-Secret ou body.secret)
PREMIUM_WEBHOOK_SECRET=
# Token MP — preference + webhook /api/premium/webhook/mercadopago
MERCADOPAGO_ACCESS_TOKEN=

# --- Extras (opcional) -------------------------------------------------------

PREMIUM_CODE=MATILHA2026
NEXT_PUBLIC_PET_SHOP_REGION=Recife
EVENT_ADMIN_SECRET=segredo_rolezinho_local
FFMPEG_PATH=/usr/bin/ffmpeg
# Mesmo valor nos dois servidores ao usar Caramelo-Sync via Tailscale
FEDERATION_EXPORT_SECRET=

# App nativo Capacitor (URL HTTPS do seu servidor — ver scripts/setup-capacitor.sh)
# CAPACITOR_SERVER_URL=https://servidor.tailXXXX.ts.net
CRON_SECRET=

# --- Smoke tests no servidor (opcional — scripts/server-smoke.sh) ------------
# Crie a conta: ./scripts/setup-smoke-account.sh
# Conta de teste só para diagnóstico; NÃO use conta principal.
# BC_SMOKE_EMAIL=smoke-test@example.com
# BC_SMOKE_USERNAME=smoke_test
# BC_SMOKE_PASSWORD=SmokeMatilha2026!

# --- Deixe vazio (sem serviços externos) -------------------------------------

OPENAI_API_KEY=
# Ollama local (opcional — Cão de Guarda): http://192.168.1.4:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=moondream
