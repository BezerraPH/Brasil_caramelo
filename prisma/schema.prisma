generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ViewMode {
  FEED
  INSTA
  REELS
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum DogReputationLevel {
  PITBULL
  HUSKY
  CARAMELO
  POODLE
  PINSCHER
  GOLDEN
  VIRALATA
  BORDER_COLLIE
  BASSET_HOUND
  CHOW_CHOW
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

enum PetBattleStatus {
  ACTIVE
  ENDED
}

enum NotificationType {
  REPUTATION_VOTE
  PET_TREAT
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FLASH_EVENT
  PET_BATTLE
  STORY_NEW
  POST_LIKE
  POST_COMMENT
  POST_MENTION
  POST_REACTION
  CHAT_MESSAGE
  ROOM_MESSAGE
  INCOMING_CALL
  TRIBUNAL_CASE
  PET_BREED_REQUEST
  PET_BREED_ACCEPTED
}

enum ReactionType {
  HEART
  AUAU
  GROWL
  WHINE
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  username     String    @unique
  bio          String?
  avatarUrl    String?
  viewMode     ViewMode  @default(FEED)
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts               Post[]
  comments            Comment[]
  likes               Like[]
  sessions            Session[]
  reputationsGiven    Reputation[]    @relation("ReputationFrom")
  reputationsReceived Reputation[]    @relation("ReputationTo")
  sentFriendships     Friendship[]    @relation("FriendshipRequester")
  receivedFriendships Friendship[]    @relation("FriendshipAddressee")
  pet                 Pet?
  notifications       Notification[]
  treatsGiven         PetTreat[]      @relation("TreatFrom")
  treatsReceived      PetTreat[]      @relation("TreatTo")
  stories             Story[]
  battlesChallenged   PetBattle[]     @relation("BattleChallenger")
  battlesOpposed      PetBattle[]     @relation("BattleOpponent")
  battleVotes         PetBattleVote[]
  storyViews          StoryView[]
  savedPosts          SavedPost[]
  postReports         PostReport[]    @relation("PostReporter")
  achievements        UserAchievement[]
  shadowbanned        Boolean         @default(false)
  conversationsAsA    Conversation[]  @relation("ConversationA")
  conversationsAsB    Conversation[]  @relation("ConversationB")
  messagesSent        Message[]
  roomMessages        CasinhaRoomMessage[]
  callsMade           CallSession[]   @relation("CallsMade")
  callsReceived       CallSession[]   @relation("CallsReceived")
  breedingSent        PetBreedingRequest[] @relation("BreedingFrom")
  breedingReceived    PetBreedingRequest[] @relation("BreedingTo")
  petOffspring        PetOffspring[]
  tribunalVotes       TribunalVote[]
  couponRedemptions   PetShopRedemption[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Post {
  id             String              @id @default(cuid())
  authorId       String
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  imageUrl       String?
  videoUrl       String?
  videoHlsUrl    String?
  communityLevel DogReputationLevel?
  boostedUntil   DateTime?
  boostPriority  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  comments       Comment[]
  likes          Like[]
  savedBy        SavedPost[]
  reports        PostReport[]
  tribunalCase   PostTribunalCase?
  tribunalHidden Boolean            @default(false)

  @@index([authorId, createdAt])
  @@index([communityLevel, createdAt])
  @@index([createdAt, id])
  @@index([boostPriority, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction  ReactionType @default(HEART)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

model PostReport {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("PostReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([postId])
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model Reputation {
  id         String             @id @default(cuid())
  fromUserId String
  fromUser   User               @relation("ReputationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User               @relation("ReputationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  level      DogReputationLevel
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([level, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

model Pet {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    @default("Caramelo")
  color             String    @default("#C68642")
  hunger            Int       @default(80)
  happiness         Int       @default(80)
  energy            Int       @default(80)
  level             Int       @default(1)
  experience        Int       @default(0)
  coins             Int       @default(50)
  ownedCosmetics    String[]  @default([])
  equippedHat       String?
  equippedCollar    String?
  equippedAccessory String?
  lastCareAt        DateTime  @default(now())
  lastDailyClaim    DateTime?
  lastFetchAt       DateTime?
  dailyStreak       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PetTreat {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("TreatFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("TreatTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, toUserId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model Story {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType StoryMediaType @default(IMAGE)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  views     StoryView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model FlashEvent {
  id             String              @id @default(cuid())
  title          String
  message        String
  coinMultiplier Float               @default(2)
  targetLevel    DogReputationLevel?
  startsAt       DateTime            @default(now())
  endsAt         DateTime
  createdAt      DateTime            @default(now())

  @@index([endsAt])
}

model PetBattle {
  id              String          @id @default(cuid())
  challengerId    String
  challenger      User            @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String
  opponent        User            @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status          PetBattleStatus @default(ACTIVE)
  votesChallenger Int             @default(0)
  votesOpponent   Int             @default(0)
  winnerId        String?
  endsAt          DateTime
  createdAt       DateTime        @default(now())
  votes           PetBattleVote[]

  @@index([status, endsAt])
}

model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @default("")
  attachmentUrl  String?
  attachmentMime String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model CasinhaRoom {
  id             String               @id @default(cuid())
  slug           String               @unique
  communityLevel DogReputationLevel
  name           String
  emoji          String
  lastMessageAt  DateTime             @default(now())
  createdAt      DateTime             @default(now())
  messages       CasinhaRoomMessage[]

  @@index([lastMessageAt])
}

model CasinhaRoomMessage {
  id             String      @id @default(cuid())
  roomId         String
  room           CasinhaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String      @default("")
  attachmentUrl  String?
  attachmentMime String?
  createdAt      DateTime    @default(now())

  @@index([roomId, createdAt])
}

model CallSession {
  id             String     @id @default(cuid())
  callerId       String
  caller         User       @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId       String
  callee         User       @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  conversationId String?
  status         CallStatus @default(RINGING)
  offerSdp       String?
  answerSdp      String?
  endedAt        DateTime?
  createdAt      DateTime   @default(now())

  @@index([calleeId, status, createdAt])
  @@index([callerId, status])
}

model MatilhaTrend {
  tag       String   @id
  count     Int
  updatedAt DateTime @updatedAt
}

model FederationPeer {
  id         String    @id @default(cuid())
  ownerId    String
  name       String
  baseUrl    String
  secret     String
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  mirrors    FederatedPostMirror[]

  @@unique([ownerId, baseUrl])
  @@index([ownerId])
}

model FederatedPostMirror {
  id              String             @id @default(cuid())
  peerId          String
  peer            FederationPeer     @relation(fields: [peerId], references: [id], onDelete: Cascade)
  externalId      String
  content         String
  communityLevel  DogReputationLevel
  authorUsername  String
  authorName      String
  sourceCreatedAt DateTime
  importedAt      DateTime           @default(now())

  @@unique([peerId, externalId])
  @@index([communityLevel, importedAt])
}

model PetBattleVote {
  id        String   @id @default(cuid())
  battleId  String
  battle    PetBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forChallenger Boolean
  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}

enum BreedingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TribunalCaseStatus {
  OPEN
  KEEP
  REMOVED
}

enum TribunalVoteChoice {
  KEEP
  REMOVE
}

model PetBreedingRequest {
  id         String                @id @default(cuid())
  fromUserId String
  fromUser   User                  @relation("BreedingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User                  @relation("BreedingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     BreedingRequestStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model PetOffspring {
  id              String             @id @default(cuid())
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentAUserId   String
  parentBUserId   String
  dnaLevel        DogReputationLevel
  color           String
  name            String             @default("Filhote")
  adoptedAt       DateTime?
  createdAt       DateTime           @default(now())

  @@index([ownerId, createdAt])
}

model PostTribunalCase {
  id          String             @id @default(cuid())
  postId      String             @unique
  post        Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  status      TribunalCaseStatus @default(OPEN)
  votesKeep   Int                @default(0)
  votesRemove Int                @default(0)
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?
  votes       TribunalVote[]

  @@index([status, createdAt])
}

model TribunalVote {
  id      String             @id @default(cuid())
  caseId  String
  case    PostTribunalCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  jurorId String
  juror   User               @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  choice  TribunalVoteChoice
  opinion String?            @db.VarChar(280)
  createdAt DateTime         @default(now())

  @@unique([caseId, jurorId])
}

model PetShopCoupon {
  id       String   @id @default(cuid())
  region   String
  shopName String
  title    String
  code     String   @unique
  coinCost Int
  active   Boolean  @default(true)
  redemptions PetShopRedemption[]

  @@index([region, active])
}

model PetShopRedemption {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    PetShopCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  qrToken   String        @unique
  createdAt DateTime      @default(now())

  @@unique([userId, couponId])
}
