generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RelationshipStatus {
  SINGLE
  IN_RELATIONSHIP
  ENGAGED
  MARRIED
  COMPLICATED
  NOT_SAYING
}

enum ViewMode {
  FEED
  INSTA
  REELS
}

enum ProfileTheme {
  CLASSIC
  SUNSET
  TROPICAL
  CARAMELO
  NIGHT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum FriendshipDegree {
  FAN
  FRIEND
  BEST_FRIEND
}

enum DogReputationLevel {
  PITBULL
  HUSKY
  CARAMELO
  POODLE
  PINSCHER
  GOLDEN
  VIRALATA
  BORDER_COLLIE
  BASSET_HOUND
  CHOW_CHOW
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

enum PetBattleStatus {
  ACTIVE
  ENDED
}

enum NotificationType {
  REPUTATION_VOTE
  PET_TREAT
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FLASH_EVENT
  PET_BATTLE
  STORY_NEW
  POST_LIKE
  POST_COMMENT
  POST_MENTION
  POST_REACTION
  CHAT_MESSAGE
  ROOM_MESSAGE
  INCOMING_CALL
  TRIBUNAL_CASE
  PET_BREED_REQUEST
  PET_BREED_ACCEPTED
  TESTIMONIAL_NEW
  TESTIMONIAL_ACCEPTED
  PET_POKE
  BISCUIT_RECEIVED
  PATIO_DUEL
  CAPSULE_RELEASED
  PHOTO_COMMENT
  POLL_RESULTS
  PACK_EVENT_REMINDER
  PREMIUM_ACTIVATED
}

enum PetPokeAction {
  PAWS
  PET_CARE
  BARK
  CHEESE_BREAD
  SNIFF
}

enum ReactionType {
  HEART
  AUAU
  GROWL
  WHINE
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  username     String    @unique
  bio          String?
  avatarUrl    String?
  viewMode          ViewMode     @default(FEED)
  profileVibe       ViewMode     @default(FEED)
  showVisits        Boolean      @default(true)
  isFoundingMember  Boolean      @default(false)
  profileTheme      ProfileTheme @default(CLASSIC)
  biscuitBalance    Int          @default(0)
  patioKingUntil    DateTime?
  locationCity      String?
  locationArea      String?
  showLocation      Boolean      @default(false)
  birthDate         DateTime?    @db.Date
  relationshipStatus RelationshipStatus?
  interests         String[]     @default([])
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts               Post[]
  comments            Comment[]
  likes               Like[]
  sessions            Session[]
  reputationsGiven    Reputation[]    @relation("ReputationFrom")
  reputationsReceived Reputation[]    @relation("ReputationTo")
  sentFriendships     Friendship[]    @relation("FriendshipRequester")
  receivedFriendships Friendship[]    @relation("FriendshipAddressee")
  pet                 Pet?
  notifications       Notification[]
  treatsGiven         PetTreat[]      @relation("TreatFrom")
  treatsReceived      PetTreat[]      @relation("TreatTo")
  stories             Story[]
  battlesChallenged   PetBattle[]     @relation("BattleChallenger")
  battlesOpposed      PetBattle[]     @relation("BattleOpponent")
  battleVotes         PetBattleVote[]
  storyViews          StoryView[]
  savedPosts          SavedPost[]
  postReports         PostReport[]    @relation("PostReporter")
  achievements        UserAchievement[]
  shadowbanned        Boolean         @default(false)
  conversationsAsA    Conversation[]  @relation("ConversationA")
  conversationsAsB    Conversation[]  @relation("ConversationB")
  messagesSent        Message[]
  roomMessages        CasinhaRoomMessage[]
  callsMade           CallSession[]   @relation("CallsMade")
  callsReceived       CallSession[]   @relation("CallsReceived")
  breedingSent        PetBreedingRequest[] @relation("BreedingFrom")
  breedingReceived    PetBreedingRequest[] @relation("BreedingTo")
  petOffspring        PetOffspring[]
  tribunalVotes       TribunalVote[]
  couponRedemptions   PetShopRedemption[]
  pushSubscriptions   PushSubscription[]
  sentTestimonials    Testimonial[]       @relation("SentTestimonials")
  receivedTestimonials Testimonial[]      @relation("ReceivedTestimonials")
  profileVisitsMade   ProfileVisit[]      @relation("ProfileVisitor")
  profileVisitsReceived ProfileVisit[]    @relation("ProfileVisited")
  petPokesSent        PetPoke[]           @relation("PetPokeFrom")
  petPokesReceived    PetPoke[]           @relation("PetPokeTo")
  patioDuelsChallenged PatioDuel[]        @relation("PatioDuelChallenger")
  patioDuelsOpposed   PatioDuel[]         @relation("PatioDuelOpponent")
  ownedPacks          Pack[]              @relation("OwnedPacks")
  packMemberships     PackMember[]
  threadsAuthored     Thread[]
  repliesAuthored     Reply[]
  postBiscuitsGiven   PostBiscuit[]     @relation("BiscuitFrom")
  packEventsCreated   PackEvent[]       @relation("PackEventCreator")
  packEventRsvps      PackEventRsvp[]
  albums              Album[]
  photoComments       PhotoComment[]
  pollVotes           PollVote[]
  postInteractions    PostInteraction[]
  premiumOrders       PremiumOrder[]
  communityMemberships CommunityMember[]
  communityThreadsAuthored CommunityThread[]
  communityRepliesAuthored CommunityReply[]
  ownedCommunities     Community[]         @relation("CommunityOwner")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Post {
  id             String              @id @default(cuid())
  authorId       String
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  imageUrl       String?
  videoUrl       String?
  videoHlsUrl    String?
  audioUrl       String?
  capsuleReleaseAt DateTime?
  capsuleNotified  Boolean             @default(false)
  communityLevel DogReputationLevel?
  boostedUntil   DateTime?
  boostPriority  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  comments       Comment[]
  likes          Like[]
  savedBy        SavedPost[]
  reports        PostReport[]
  biscuits       PostBiscuit[]
  tribunalCase   PostTribunalCase?
  tribunalHidden Boolean            @default(false)
  reelScore      Float              @default(0)
  interactions   PostInteraction[]
  communityId    String?
  community      Community?          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  nostrEventId   String?

  @@index([authorId, createdAt])
  @@index([communityId, createdAt])
  @@index([communityLevel, createdAt])
  @@index([createdAt, id])
  @@index([boostPriority, createdAt])
  @@index([reelScore, createdAt])
  @@index([nostrEventId])
}

model PostInteraction {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchMs    Int      @default(0)
  completed  Boolean  @default(false)
  liked      Boolean  @default(false)
  shared     Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  audioUrl  String?
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction  ReactionType @default(HEART)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

model PostBiscuit {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("BiscuitFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([postId, fromUserId])
  @@index([postId])
}

model PostReport {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("PostReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([postId])
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model Reputation {
  id         String             @id @default(cuid())
  fromUserId String
  fromUser   User               @relation("ReputationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User               @relation("ReputationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  level      DogReputationLevel
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([level, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status           FriendshipStatus @default(PENDING)
  requesterDegree  FriendshipDegree @default(FRIEND)
  addresseeDegree  FriendshipDegree @default(FRIEND)
  createdAt        DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([status, requesterId])
  @@index([status, addresseeId])
}

model Pet {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    @default("Caramelo")
  color             String    @default("#C68642")
  hunger            Int       @default(80)
  happiness         Int       @default(80)
  energy            Int       @default(80)
  level             Int       @default(1)
  experience        Int       @default(0)
  coins             Int       @default(50)
  ownedCosmetics    String[]  @default([])
  equippedHat       String?
  equippedCollar    String?
  equippedAccessory String?
  lastCareAt        DateTime  @default(now())
  lastDailyClaim    DateTime?
  lastFetchAt       DateTime?
  dailyStreak       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PetTreat {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("TreatFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("TreatTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, toUserId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model Story {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType StoryMediaType @default(IMAGE)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  views     StoryView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model FlashEvent {
  id             String              @id @default(cuid())
  title          String
  message        String
  coinMultiplier Float               @default(2)
  targetLevel    DogReputationLevel?
  startsAt       DateTime            @default(now())
  endsAt         DateTime
  createdAt      DateTime            @default(now())

  @@index([endsAt])
}

model PetBattle {
  id              String          @id @default(cuid())
  challengerId    String
  challenger      User            @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String
  opponent        User            @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status          PetBattleStatus @default(ACTIVE)
  votesChallenger Int             @default(0)
  votesOpponent   Int             @default(0)
  winnerId        String?
  endsAt          DateTime
  createdAt       DateTime        @default(now())
  votes           PetBattleVote[]

  @@index([status, endsAt])
}

model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @default("")
  attachmentUrl  String?
  attachmentMime String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model CasinhaRoom {
  id             String               @id @default(cuid())
  slug           String               @unique
  communityLevel DogReputationLevel
  name           String
  emoji          String
  lastMessageAt  DateTime             @default(now())
  createdAt      DateTime             @default(now())
  messages       CasinhaRoomMessage[]

  @@index([lastMessageAt])
}

model CasinhaRoomMessage {
  id             String      @id @default(cuid())
  roomId         String
  room           CasinhaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String      @default("")
  attachmentUrl  String?
  attachmentMime String?
  createdAt      DateTime    @default(now())

  @@index([roomId, createdAt])
}

model CallSession {
  id             String     @id @default(cuid())
  callerId       String
  caller         User       @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId       String
  callee         User       @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  conversationId String?
  status         CallStatus @default(RINGING)
  offerSdp       String?
  answerSdp      String?
  endedAt        DateTime?
  createdAt      DateTime   @default(now())

  @@index([calleeId, status, createdAt])
  @@index([callerId, status])
}

model MatilhaTrend {
  tag       String   @id
  count     Int
  updatedAt DateTime @updatedAt
}

model FederationPeer {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  baseUrl     String
  secret      String
  networkType String    @default("lan")
  lastSyncAt  DateTime?
  lastProbeAt DateTime?
  lastProbeOk Boolean?
  createdAt   DateTime  @default(now())
  mirrors     FederatedPostMirror[]

  @@unique([ownerId, baseUrl])
  @@index([ownerId])
  @@index([networkType])
}

model FederatedPostMirror {
  id              String             @id @default(cuid())
  peerId          String
  peer            FederationPeer     @relation(fields: [peerId], references: [id], onDelete: Cascade)
  externalId      String
  content         String
  communityLevel  DogReputationLevel
  authorUsername  String
  authorName      String
  sourceCreatedAt DateTime
  importedAt      DateTime           @default(now())

  @@unique([peerId, externalId])
  @@index([communityLevel, importedAt])
}

model PetBattleVote {
  id        String   @id @default(cuid())
  battleId  String
  battle    PetBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forChallenger Boolean
  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}

enum BreedingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TribunalCaseStatus {
  OPEN
  KEEP
  REMOVED
}

enum TribunalVoteChoice {
  KEEP
  REMOVE
}

model PetBreedingRequest {
  id         String                @id @default(cuid())
  fromUserId String
  fromUser   User                  @relation("BreedingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User                  @relation("BreedingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     BreedingRequestStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model PetOffspring {
  id              String             @id @default(cuid())
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentAUserId   String
  parentBUserId   String
  dnaLevel        DogReputationLevel
  color           String
  name            String             @default("Filhote")
  adoptedAt       DateTime?
  createdAt       DateTime           @default(now())

  @@index([ownerId, createdAt])
}

model PostTribunalCase {
  id          String             @id @default(cuid())
  postId      String             @unique
  post        Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  status      TribunalCaseStatus @default(OPEN)
  votesKeep   Int                @default(0)
  votesRemove Int                @default(0)
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?
  votes       TribunalVote[]

  @@index([status, createdAt])
}

model TribunalVote {
  id      String             @id @default(cuid())
  caseId  String
  case    PostTribunalCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  jurorId String
  juror   User               @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  choice  TribunalVoteChoice
  opinion String?            @db.VarChar(280)
  createdAt DateTime         @default(now())

  @@unique([caseId, jurorId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PetShopCoupon {
  id           String   @id @default(cuid())
  region       String
  city         String?
  neighborhood String?
  address      String?
  lat          Float?
  lng          Float?
  phone        String?
  partnerUrl   String?
  shopName     String
  title        String
  code         String   @unique
  coinCost     Int
  active       Boolean  @default(true)
  redemptions  PetShopRedemption[]

  @@index([region, active])
  @@index([city, active])
}

model PetShopRedemption {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    PetShopCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  qrToken   String        @unique
  createdAt DateTime      @default(now())

  @@unique([userId, couponId])
}

model Testimonial {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  content    String
  audioUrl   String?
  accepted   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  fromUser User @relation("SentTestimonials", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedTestimonials", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, accepted])
  @@index([toUserId, acceptedAt])
}

model ProfileVisit {
  id        String   @id @default(cuid())
  visitorId String
  visitedId String
  visitedAt DateTime @default(now()) @updatedAt

  visitor User @relation("ProfileVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  visited User @relation("ProfileVisited", fields: [visitedId], references: [id], onDelete: Cascade)

  @@unique([visitorId, visitedId])
  @@index([visitedId, visitedAt])
}

model PatioDuel {
  id           String   @id @default(cuid())
  challengerId String
  opponentId   String
  winnerId     String?
  createdAt    DateTime @default(now())

  challenger User @relation("PatioDuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("PatioDuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, createdAt])
  @@index([opponentId, createdAt])
}

model PetPoke {
  id         String        @id @default(cuid())
  fromUserId String
  toUserId   String
  action     PetPokeAction
  createdAt  DateTime      @default(now())

  fromUser User @relation("PetPokeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("PetPokeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, createdAt])
  @@index([fromUserId, toUserId])
}

model Pack {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  description String
  avatarUrl   String?
  bannerUrl   String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner   User         @relation("OwnedPacks", fields: [ownerId], references: [id])
  members PackMember[]
  threads Thread[]
  events  PackEvent[]
  community Community?

  @@index([createdAt])
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
}

model Community {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  emoji        String   @default("🏘️")
  category     String   @default("outros")
  themePrimary String   @default("#005f38")
  themeAccent  String   @default("#ffc72c")
  pinnedRules  String   @default("")
  ownerId      String?
  packId       String?  @unique
  createdAt    DateTime @default(now())

  owner   User?              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pack    Pack?              @relation(fields: [packId], references: [id], onDelete: SetNull)
  members CommunityMember[]
  threads CommunityThread[]
  posts   Post[]

  @@index([category])
}

model CommunityThread {
  id          String   @id @default(cuid())
  communityId String
  title       String
  authorId    String
  pinned      Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  community Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User               @relation(fields: [authorId], references: [id])
  replies   CommunityReply[]

  @@index([communityId, pinned, createdAt])
  @@index([communityId, archived, createdAt])
}

model CommunityReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  thread CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User            @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
}

model CommunityMember {
  id          String               @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole  @default(MEMBER)
  joinedAt    DateTime             @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model PackMember {
  id       String   @id @default(cuid())
  packId   String
  userId   String
  joinedAt DateTime @default(now())

  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packId, userId])
  @@index([userId])
}

model Thread {
  id         String   @id @default(cuid())
  packId     String
  title      String
  authorId   String
  pinned     Boolean  @default(false)
  isGolden   Boolean  @default(false)
  archived   Boolean  @default(false)
  anonymous  Boolean  @default(false)
  createdAt  DateTime @default(now())

  pack    Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
  replies Reply[]
  poll    ThreadPoll?

  @@index([packId, pinned, isGolden])
  @@index([packId, archived, createdAt])
}

model Reply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
}

model ThreadPoll {
  id                String       @id @default(cuid())
  threadId          String       @unique
  thread            Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  question          String?
  closesAt          DateTime?
  resultsNotifiedAt DateTime?
  createdAt         DateTime     @default(now())
  options           PollOption[]
  votes             PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      ThreadPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int        @default(0)
  votes     PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      ThreadPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([optionId])
}

enum PremiumOrderStatus {
  PENDING
  PAID
  CANCELLED
}

model PremiumOrder {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference  String             @unique
  amountBrl  String
  provider   String             @default("pix_manual")
  externalId String?
  status     PremiumOrderStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

model PackEvent {
  id          String   @id @default(cuid())
  packId      String
  creatorId   String
  title       String
  description String?
  location    String
  startsAt    DateTime
  latidosRoom String?
  createdAt   DateTime @default(now())

  pack    Pack            @relation(fields: [packId], references: [id], onDelete: Cascade)
  creator User            @relation("PackEventCreator", fields: [creatorId], references: [id])
  rsvps   PackEventRsvp[]

  @@index([packId, startsAt])
}

model PackEventRsvp {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  ticketToken String   @unique
  createdAt   DateTime @default(now())

  event PackEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Album {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]

  @@index([userId, createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  comments  PhotoComment[]

  @@index([albumId, sortOrder])
}

model PhotoComment {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  audioUrl  String?
  createdAt DateTime @default(now())

  @@index([photoId])
}
