# Brasil Caramelo — Caddyfile (Proxy Reverso HTTPS Local & Domínio)
{
    admin off
    default_sni 192.168.1.6
}

http://192.168.1.6, http://localhost, http://ntek-servidor {
    redir https://{host}{uri} permanent
}

https://192.168.1.6, https://localhost, https://ntek-servidor, https://100.94.55.27 {
    tls internal

    # Soketi / Pusher endpoints
    handle /app/* {
        reverse_proxy soketi:6001
    }
    handle /apps/* {
        reverse_proxy soketi:6001
    }

    # LiveKit WebRTC
    handle /rtc/* {
        reverse_proxy livekit:7880
    }

    # Next.js App
    handle {
        reverse_proxy app:3000
    }
}
