# Brasil Caramelo — Caddyfile (Proxy Reverso Universal HTTPS)
{
    admin off
}

:80 {
    redir https://{host}{uri} permanent
}

:443 {
    tls internal

    # Soketi / Pusher endpoints
    handle /app/* {
        reverse_proxy soketi:6001
    }

    handle /apps/* {
        reverse_proxy soketi:6001
    }

    # LiveKit WebRTC
    handle /rtc/* {
        reverse_proxy livekit:7880
    }

    # Next.js App (suporta WebSockets e HTTP nativamente)
    handle {
        reverse_proxy app:3000
    }
}
