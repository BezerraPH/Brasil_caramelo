# Brasil Caramelo — Caddyfile (Proxy Reverso HTTPS Local & Domínio)
{
    admin off
}

brasilcaramelo.com, brasilcaramelo.com.br, brasilcaramelo.local, ntek-servidor, ntek-servidor.tail51633c.ts.net, 192.168.1.6, 100.94.55.27, localhost, 127.0.0.1 {
    tls internal

    # Soketi / Pusher endpoints
    handle /app/* {
        reverse_proxy soketi:6001
    }

    handle /apps/* {
        reverse_proxy soketi:6001
    }

    # LiveKit WebRTC
    handle /rtc/* {
        reverse_proxy livekit:7880
    }

    # Next.js App
    handle {
        reverse_proxy app:3000
    }
}
